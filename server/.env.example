# Copy to server/.env. Never commit server/.env.
# Gemini, ElevenLabs, and Tiger Data are live credentials.
# Vultr and Solana stay in demo mode. Backboard uses the labeled demo adapter until BACKBOARD_API_KEY is set.
# The api container must not receive SOLANA_SECRET_KEY_B58 (chain.env only).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
# Empty keeps the labeled demo adapter. A value selects backboard-sdk. Never commit the value.
BACKBOARD_API_KEY=
TIGER_DATABASE_URL=
SOLANA_RPC_URL=https://api.devnet.solana.com
ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173
SIM_TIMEOUT_ONE_MODE_S=8
SIM_TIMEOUT_TWO_MODE_S=15
JAX_COMPILATION_CACHE_DIR=/cache/jax
CHAIN_HEALTH_URL=http://127.0.0.1:8100/api/chain/health
ACADEMY_WARMUP=1
